# Build-input allowlist: never send local credentials, models or Cargo caches
# to the Docker daemon. Keep this aligned with Dockerfile COPY instructions.
**
!Cargo.toml
!Cargo.lock
!examples/
!examples/**
!vendor/
!vendor/**
!src/
!src/**
!build.rs
!frontend/
!frontend/**
frontend/node_modules
frontend/dist
!models.sha256.json

**/.git
**/target
**/build
**/node_modules

# Exclude developer credentials and model weights even below allowlisted trees.
**/.env
**/.env.*
**/tokens.json
**/*.onnx
**/*.gguf
**/*.safetensors

# Tiny offline inference diagnostic, not a provider weight.
!assets/
!assets/runtime-identity.onnx
